{
  "name": "@seshat/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json && node dist/main.js",
    "test": "vitest run",
    "admin:hash-password": "tsx scripts/hash-password.ts",
    "typeorm": "tsx node_modules/typeorm/cli.js",
    "migration:run": "tsx node_modules/typeorm/cli.js migration:run -d src/database/data-source.ts",
    "migration:revert": "tsx node_modules/typeorm/cli.js migration:revert -d src/database/data-source.ts",
    "migration:generate": "tsx node_modules/typeorm/cli.js migration:generate -d src/database/data-source.ts",
    "migration:create": "tsx node_modules/typeorm/cli.js migration:create"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.109",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/typeorm": "^12.0.2",
    "@seshat/domain": "workspace:*",
    "ai": "^7.0.163",
    "argon2": "^0.45.2",
    "busboy": "1.6.0",
    "pg": "^8.23.1",
    "pg-boss": "^12.38.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/busboy": "^1.5.5",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
