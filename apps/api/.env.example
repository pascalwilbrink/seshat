# Copy to apps/api/.env for local development. Values below are local-only examples.

# Required. PostgreSQL (with pgvector) connection URL.
DATABASE_URL=postgres://seshat:seshat@localhost:5432/seshat

# Required. Single admin login. There is no user table.
ADMIN_USERNAME=admin

# Required. Argon2id hash of the admin password (12-256 characters). Generate it from the repo root; it prompts
# without echo and prints only the hash, which you paste here exactly as printed:
#   pnpm --filter @seshat/api admin:hash-password
# The value below is a non-working placeholder: the API refuses to start until you replace it.
ADMIN_PASSWORD_HASH=replace-with-output-of-admin-hash-password

# Required, at least 32 characters. Signs session cookies (HttpOnly, SameSite=Lax, 7 days; Secure whenever
# NODE_ENV is not development, so serve over HTTPS there). Generate one, e.g.: openssl rand -base64 48
# The value below is a non-working placeholder: replace it.
SESSION_SECRET=replace-me

# Required, at least 32 characters. Secret key (pepper) of the HMAC-SHA-256 under which API keys are stored; keys are
# never stored in plain text. Keep it secret and stable: changing it invalidates every existing API key.
# Generate one, e.g.: openssl rand -base64 48
# The value below is a non-working placeholder: replace it.
API_KEY_PEPPER=replace-me

# Optional. Number of reverse-proxy hops to trust for the client IP (login rate limit). Default: false
# (X-Forwarded-For is ignored). Set to 1 only when exactly one trusted proxy sets it.
# TRUST_PROXY=false

# Optional. HTTP port (integer 1-65535). Default: 4200.
PORT=4200

# Optional. One of development, test, production. Default: development.
NODE_ENV=development

# Optional. Run pending migrations at startup (exactly true or false). Default: true in development, false otherwise.
DB_MIGRATE_ON_START=true

# Optional, integration tests only (never read by the API). URL of a disposable, dedicated test database.
# TEST_DATABASE_URL=postgres://seshat:seshat@localhost:5432/seshat_test

# CI only. When exactly true, a missing TEST_DATABASE_URL fails the test run instead of skipping the integration
# suites. Leave unset locally so plain `pnpm test` stays database-free.
# REQUIRE_INTEGRATION_TESTS=true
