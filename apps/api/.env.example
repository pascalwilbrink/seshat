# Copy to apps/api/.env for local development. Values below are local-only examples.

# Required. PostgreSQL (with pgvector) connection URL.
DATABASE_URL=postgres://seshat:seshat@localhost:5432/seshat

# Required. Single admin login. There is no user table.
ADMIN_USERNAME=admin

# Required. Argon2id hash of the admin password (12-256 characters). Generate it from the repo root; it prompts
# without echo and prints only the hash, which you paste here exactly as printed:
#   pnpm --filter @seshat/api admin:hash-password
# The value below is a non-working placeholder: the API refuses to start until you replace it.
ADMIN_PASSWORD_HASH=replace-with-output-of-admin-hash-password

# Required, at least 32 characters. Signs session cookies (HttpOnly, SameSite=Lax, 7 days; Secure whenever
# NODE_ENV is not development, so serve over HTTPS there). Generate one, e.g.: openssl rand -base64 48
# The value below is a non-working placeholder: replace it.
SESSION_SECRET=replace-me

# Required, at least 32 characters. Secret key (pepper) of the HMAC-SHA-256 under which API keys are stored; keys are
# never stored in plain text. Keep it secret and stable: changing it invalidates every existing API key.
# Generate one, e.g.: openssl rand -base64 48. Never reuse SESSION_SECRET, never commit or log it.
# Changing it invalidates every existing API key (create new ones afterwards). Needs the api_keys migration.
# The value below is a non-working placeholder: replace it.
API_KEY_PEPPER=replace-me

# Optional. Number of reverse-proxy hops to trust for the client IP (login rate limit). Default: false
# (X-Forwarded-For is ignored). Set to 1 only when exactly one trusted proxy sets it.
# TRUST_PROXY=false

# Required for the API (not for migration commands). Existing, writable directory on a local volume where original
# uploaded files are stored. Startup fails with a sanitized message when it is missing or not writable.
FILE_STORAGE_DIR=./data/files

# Optional. Largest accepted upload in bytes (positive integer). Default: 52428800 (50 MB).
# MAX_UPLOAD_BYTES=52428800

# Required for the API (not for migration commands; startup fails naming only this variable when it is missing).
# OpenAI API key used for embeddings. Never commit or log it. The value below is a non-working placeholder: replace it.
OPENAI_API_KEY=replace-me

# Optional. Embedding model name (1-200 characters, no whitespace). Default: text-embedding-3-small.
# Changing it does not re-index existing files; re-index them (POST .../files/reindex) to avoid mixed models.
# EMBEDDING_MODEL=text-embedding-3-small

# Optional. Embedding vector dimension (positive integer). Default: 1536. Must equal the physical chunks.embedding column
# (vector(1536)); the API refuses to start otherwise. Another dimension needs a migration plus a re-index of all files.
# EMBEDDING_DIMENSION=1536

# Optional. Minimum cosine similarity (a number from 0 to 1) for the "similar Memories" hint returned when a Memory is
# created. Default: 0.9. Hints only suggest candidates to supersede; nothing is merged automatically. Memories use the
# embedding settings above (OPENAI_API_KEY, EMBEDDING_MODEL, EMBEDDING_DIMENSION) and no separate provider settings.
# Memory rules (not configurable): six types; an exact duplicate (same scope, type and normalized content) is reused;
# supersession is always explicit; provenance is set by the server. Contents, titles and vectors are never logged.
# MEMORY_SIMILARITY_HINT=0.9

# Optional. Parallel ingest-file jobs per API process (positive integer). Default: 2. pg-boss uses the
# DATABASE_URL database in its own "pgboss" schema; jobs get 3 attempts in total with exponential backoff.
# INGESTION_CONCURRENCY=2

# Optional. Characters per chunk (positive integer). Default: 2000.
# CHUNK_SIZE_CHARS=2000

# Optional. Characters shared by consecutive chunks (integer >= 0, smaller than CHUNK_SIZE_CHARS). Default: 200.
# CHUNK_OVERLAP_CHARS=200

# Optional. HTTP port (integer 1-65535). Default: 4200.
PORT=4200

# Optional. One of development, test, production. Default: development.
NODE_ENV=development

# Optional. Run pending migrations at startup (exactly true or false). Default: true in development, false otherwise.
DB_MIGRATE_ON_START=true

# Optional, integration tests only (never read by the API). URL of a disposable, dedicated test database.
# TEST_DATABASE_URL=postgres://seshat:seshat@localhost:5432/seshat_test

# CI only. When exactly true, a missing TEST_DATABASE_URL fails the test run instead of skipping the integration
# suites. Leave unset locally so plain `pnpm test` stays database-free.
# REQUIRE_INTEGRATION_TESTS=true
