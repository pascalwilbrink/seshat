# Copy to apps/web/.env.local (optional: the default already matches the local API).
# Server-side only. The browser always calls the web origin's relative /api paths, which Next proxies here.
# Never prefix this with NEXT_PUBLIC. Default: http://localhost:4200
API_URL=http://localhost:4200

# Public address of the API's MCP endpoint, shown on the Workspace MCP page. MCP clients connect to the API directly, so use
# the URL under which the API is reachable from the client. Must be an absolute http(s) URL ending in /mcp; read at runtime.
# Default: http://localhost:4200/mcp
SESHAT_MCP_URL=http://localhost:4200/mcp
