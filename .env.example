# Docker / Compose deployment. Copy to `.env` in the repository root (`cp .env.example .env`); `.env` is Git-ignored.
# This is NOT apps/api/.env.example (that one is for running the API locally with pnpm). Values below are placeholders.
#
# QUOTING: wrap values containing `$` in SINGLE quotes, exactly as below. Compose would otherwise treat `$argon2id`
# as a variable. Single-quoted values reach the app unchanged. Do not use double quotes for the hash.
# Never commit `.env`, never paste it into logs or issues.

# ---- Database (Compose service `db`) ----
# Defaults seshat/seshat/seshat are fine for local use. Change them for any shared host. They only apply when the
# `pgdata` volume is created: changing them later does not change an existing database. Use URL-safe characters in the
# password (it is placed in DATABASE_URL, which Compose builds as postgres://USER:PASSWORD@db:5432/DB and which
# overrides any DATABASE_URL set here), e.g. generate one with: openssl rand -hex 24
# POSTGRES_USER=seshat
# POSTGRES_PASSWORD=replace-with-url-safe-random-value
# POSTGRES_DB=seshat

# ---- Published ports (host side; the container always uses 3000 and 4200) ----
# SESHAT_WEB_PORT=3000
# SESHAT_API_PORT=4200
# DB_HOST_PORT=5432

# ---- Required by the API ----
ADMIN_USERNAME=admin
# Argon2id hash of the admin password (12-256 characters). Generate it from a checkout:
#   pnpm --filter @seshat/api admin:hash-password
# and paste the printed hash between single quotes. Placeholder: the API refuses to start until replaced.
ADMIN_PASSWORD_HASH='replace-with-single-quoted-argon2id-hash'
# At least 32 characters: openssl rand -base64 48. Signs session cookies.
SESSION_SECRET=replace-with-random-value-of-at-least-32-chars
# At least 32 characters, different from SESSION_SECRET: openssl rand -base64 48. Keep it stable: changing it
# invalidates every API key.
API_KEY_PEPPER=replace-with-another-random-value-of-at-least-32-chars
# OpenAI key for embeddings.
OPENAI_API_KEY=replace-me

# ---- Image defaults (already set in the image; override only when needed) ----
# NODE_ENV=production            session cookies are Secure: use HTTPS (or localhost) in front of the UI
# DB_MIGRATE_ON_START=true       run pending migrations before the API listens
# FILE_STORAGE_DIR=/data/files   the `files` named volume; do not change
# PORT is managed by the image (API 4200, web 3000); do not set it here.

# ---- Optional ----
# TRUST_PROXY=false              set to 1 behind exactly one trusted reverse proxy
# MAX_UPLOAD_BYTES=52428800
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSION=1536       must match the physical chunks.embedding column (vector(1536))
# MEMORY_SIMILARITY_HINT=0.9
# MCP_MAX_UPLOAD_BYTES=10485760   largest decoded MCP upload_file; /mcp body limit derives from it
# MCP_MAX_RESULT_CHARS=20000       MCP tool results are cut at this many characters
# INGESTION_CONCURRENCY=2
# CHUNK_SIZE_CHARS=2000
# CHUNK_OVERLAP_CHARS=200
